# HTTP port
PORT=8080
# Database (matches docker-compose.yaml)
DB_URL=jdbc:postgresql://localhost:5432/app
DB_USERNAME=app
DB_PASSWORD=app
# JWT signing key, at least 32 bytes (required)
APP_JWT_SECRET=change-me-to-a-random-string-of-32-bytes-or-more
# Access token lifetime
APP_JWT_ACCESS_TTL=15m
# Refresh token lifetime
APP_JWT_REFRESH_TTL=30d
# First admin, created only while the user table is empty
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me-please
APP_ADMIN_NAME=Admin
# Comma-separated CORS origins
APP_CORS_ORIGINS=http://localhost:3000
# Base URL used in email links
APP_FRONTEND_URL=http://localhost:3000
# Mail mode: log or smtp
APP_MAIL_MODE=log
# Sender address
APP_MAIL_FROM=no-reply@example.com
# SMTP server (only when APP_MAIL_MODE=smtp)
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
